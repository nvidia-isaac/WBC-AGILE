--- /dev/null
+++ b/rsl_rl/models/jit_teacher_model.py
@@ -0,0 +1,61 @@
+# Copyright (c) 2021-2026, ETH Zurich and NVIDIA CORPORATION
+# All rights reserved.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+
+from __future__ import annotations
+
+import torch
+from tensordict import TensorDict
+
+from rsl_rl.modules import HiddenState
+
+
+class JitTeacherModel(torch.nn.Module):
+    """Teacher model backed by an exported TorchScript policy.
+
+    AGILE distills deployable student policies from already-exported teacher
+    policies. Public rsl_rl 5.x expects the teacher to be a model constructed
+    from Python architecture config, so this adapter exposes the same minimal
+    model interface while delegating inference to ``torch.jit.load``.
+    """
+
+    is_recurrent: bool = False
+    teacher_loaded: bool = True
+
+    def __init__(
+        self,
+        obs: TensorDict,
+        obs_groups: dict[str, list[str]],
+        obs_set: str,
+        output_dim: int,  # noqa: ARG002
+        teacher_path: str,
+    ) -> None:
+        super().__init__()
+        self.obs_groups = obs_groups[obs_set]
+        self.teacher = torch.jit.load(teacher_path)
+        self.teacher.eval()
+
+    def forward(
+        self,
+        obs: TensorDict,
+        masks: torch.Tensor | None = None,  # noqa: ARG002
+        hidden_state: HiddenState = None,  # noqa: ARG002
+        stochastic_output: bool = False,  # noqa: ARG002
+    ) -> torch.Tensor:
+        latent = torch.cat([obs[obs_group] for obs_group in self.obs_groups], dim=-1)
+        with torch.no_grad():
+            return self.teacher(latent)
+
+    def reset(self, dones: torch.Tensor | None = None, hidden_state: HiddenState = None) -> None:  # noqa: ARG002
+        if hasattr(self.teacher, "reset"):
+            self.teacher.reset()
+
+    def get_hidden_state(self) -> HiddenState:
+        return None
+
+    def detach_hidden_state(self, dones: torch.Tensor | None = None) -> None:  # noqa: ARG002
+        pass
+
+    def update_normalization(self, obs: TensorDict) -> None:  # noqa: ARG002
+        pass
